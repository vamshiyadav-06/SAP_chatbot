# Local browser-test stack only. Copy to .env.e2e and never point this project at real data.
COMPOSE_PROJECT_NAME=sap_brim_e2e
APP_ENV_FILE=.env.e2e
IMAGE_TAG=e2e
APP_DOMAIN=localhost
ALLOWED_ORIGINS=https://localhost
ENVIRONMENT=development
HTTP_PORT=18080
HTTPS_PORT=18443
WEB_BIND=127.0.0.1
APP_UID=1000
ACCESS_MODE=open
STAGING_BASIC_AUTH_USER=e2e
STAGING_BASIC_AUTH_HASH=
POSTGRES_USER=sap_assistant
POSTGRES_PASSWORD=e2e-local-only-postgres
POSTGRES_DB=sap_assistant
SAP_BRIM_DB_PASSWORD=e2e-local-only-app
DATABASE_URL=postgresql://sap_brim_ai:e2e-local-only-app@postgres:5432/sap_brim_ai
DATABASE_CONNECT_TIMEOUT=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
JWT_SECRET=e2e-local-only-secret-do-not-reuse
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1
ADMIN_API_KEY=
SUPER_ADMIN_EMAIL=e2e-admin@example.invalid
SUPER_ADMIN_PASSWORD=e2e-local-only-admin-password
REGISTRATION_ENABLED=False
DEFAULT_ACCESS_GROUP=all
RATE_LIMIT_ENABLED=True
REDIS_URL=
LLM_PROVIDER=openrouter
LLM_ALLOWED_PROVIDERS=openrouter
LLM_ALLOW_FREE_TIER=False
LLM_MODEL=stub/model
OPENROUTER_BASE_URL=http://stub-llm:9100/v1
OPENROUTER_API_KEY=e2e-stub-key
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_API_KEY=
LLM_REQUEST_DEADLINE_SECONDS=12
MAX_MESSAGE_CHARS=12000
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
TOP_K=10
RERANK_TOP_K=4
RETRIEVAL_CACHE_WARMUP=False
SIMILARITY_THRESHOLD=0.60
GROUNDING_THRESHOLD=0.65
DOCUMENT_MATCH_THRESHOLD=0.80
AUTO_MULTI_SOURCE_FALLBACK=False
ANSWER_TEMPERATURE=0.10
INCLUDE_SELF_AUTHORED_DOCS=False
WEB_FALLBACK_ENABLED=False
WEB_SEARCH_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_MAX_IMAGES=0
REPO_SOURCE_ENABLED=False
MULTI_SOURCE_COMPARE_ENABLED=False
SAP_WEB_SOURCES_ENABLED=False
ORG_ACTIVATION_CODE_TTL_HOURS=72
ORG_ACTIVATION_RATE_LIMIT_PER_MINUTE=10
ORG_REQUEST_RATE_LIMIT_PER_HOUR=5
ORG_MEMBER_CREATE_RATE_LIMIT_PER_HOUR=30
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1g
BACKEND_CPUS=2.0
BACKEND_MEMORY=3g
WEB_CPUS=0.5
WEB_MEMORY=256m
