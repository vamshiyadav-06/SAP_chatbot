# Front door of docker-compose.prod.yml (see DEPLOYMENT.md):
# - HTTPS for APP_DOMAIN with automatic Let's Encrypt certificates (needs DNS for the domain pointing at
#   this server and ports 80 and 443 open). APP_DOMAIN=localhost uses Caddy's own local certificate.
# - /api/* and /health go to the backend container; streamed answers (Server-Sent Events) are flushed
#   immediately. The backend trusts this proxy's X-Forwarded-For / X-Forwarded-Proto (TRUSTED_PROXIES).
# - Everything else is the React app; client-side routes fall back to index.html.
# - ACCESS_MODE selects an access snippet from caddy/access/: "open" (production) or "basic_auth"
#   (staging gate). An unknown value fails at start instead of silently opening the site.

{$APP_DOMAIN:localhost} {
	import /etc/caddy/access/{$ACCESS_MODE:open}.caddy

	handle /api/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		encode zstd gzip

		# The built index.html also carries a Content-Security-Policy meta tag (frontend/vite.config.ts);
		# frame-ancestors only works as a header.
		header {
			Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			# Voice input in the chat box uses the browser's speech recognition.
			Permissions-Policy "camera=(), microphone=(self), geolocation=()"
			-Server
		}

		@public_host not host localhost 127.0.0.1
		header @public_host Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Hashed build assets never change; index.html and the rest are revalidated on every load.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@not_assets not path /assets/*
		header @not_assets Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
