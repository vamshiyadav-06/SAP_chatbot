# Frontend (Vite) settings template. OPTIONAL: the defaults work for local development and for the
# Docker production stack, so most setups need no frontend/.env at all.
# Copy to frontend/.env (or frontend/.env.local) only to change something. Vite reads these at build/dev
# time and writes VITE_* values into the JavaScript bundle, so never put secrets here.
# Backend settings live in the repository-root .env (see ../.env.example).

# Where the browser sends API requests. Empty: the same-origin path /api, which the Vite dev server
# (`npm run dev`, `npm run preview`) and the production web container forward to the backend.
# Set only when the API is on another origin, e.g. https://api.example.com/api (that page's origin must be
# in the backend's ALLOWED_ORIGINS). Also feeds the production Content-Security-Policy connect-src.
VITE_API_BASE_URL=

# Development only: where the Vite dev server forwards /api. Default http://localhost:8000.
VITE_DEV_API_PROXY_TARGET=

# Show the "Sign up" button on the landing page and the Sign up tab on /login. Must match the backend's
# REGISTRATION_ENABLED (when the backend has sign-up closed, leave this unset or false: the button would
# only lead to "Sign-up is temporarily unavailable"). Build/dev time value; restart `npm run dev` after changing.
# VITE_REGISTRATION_ENABLED=true
