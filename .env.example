# =====================================================================================================
# SAP BRIM AI (Clyptus.AI) - LOCAL DEVELOPMENT settings template
# =====================================================================================================
# Copy to `.env` in the repository root (never commit `.env`):
#     Windows:        Copy-Item .env.example .env
#     macOS / Linux:  cp .env.example .env
# That one file is read by Docker Compose (docker-compose.yml, the database) and by the FastAPI backend
# (backend/app/config.py). Setup guide: SETUP.md. For a server use .env.production.example (DEPLOYMENT.md).
#
# REQUIRED before the first start (Compose and the backend refuse to start without 1 and 2):
#   1. POSTGRES_PASSWORD and SAP_BRIM_DB_PASSWORD (and the same app password inside DATABASE_URL)
#   2. JWT_SECRET  (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
#   3. SUPER_ADMIN_EMAIL + SUPER_ADMIN_PASSWORD (your admin login; without them there is no admin)
#   4. At least one LLM key (GROQ_API_KEY is the default provider), otherwise answers are "unavailable"
# Use URL-safe passwords (letters, digits, - and _): they are also written inside DATABASE_URL.
# Every other setting has a working default; the full list with defaults is backend/app/config.py.
# =====================================================================================================

# ===== Docker Compose: PostgreSQL + pgvector container =====

# Host port mapped to the container's 5432. Must match the port in DATABASE_URL below.
POSTGRES_HOST_PORT=5434

# Superuser; only applied when the data volume is first initialised.
POSTGRES_USER=sap_assistant
POSTGRES_PASSWORD=change-me-superuser-password
POSTGRES_DB=sap_assistant

# Password for the application role "sap_brim_ai" (created on first initialisation).
# Must match the password in DATABASE_URL below.
SAP_BRIM_DB_PASSWORD=change-me-app-password

# ===== Backend (FastAPI) =====

# Database: PostgreSQL + pgvector in Docker (the only supported database; no fallback).
# Start it with `docker compose up -d postgres` from the repository root.
# Format: postgresql://sap_brim_ai:<SAP_BRIM_DB_PASSWORD>@127.0.0.1:<POSTGRES_HOST_PORT>/sap_brim_ai
DATABASE_URL=postgresql://sap_brim_ai:change-me-app-password@127.0.0.1:5434/sap_brim_ai
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Security
# REQUIRED: a random value of at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse a value from this file: published values are rejected at startup.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# development or production. Production disables /docs, requires HTTPS (except /health), adds HSTS
# and refuses empty, wildcard or localhost ALLOWED_ORIGINS. Keep "development" on your own machine.
ENVIRONMENT=development
# Browser origins allowed to call the API directly. The Vite dev server proxies /api, so these matter only
# when a page on another origin calls http://localhost:8000 itself.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Apply Alembic migrations at startup. Convenient for development. In production set False and run
#   python -m alembic -c backend/alembic.ini upgrade head
# as a deploy step; startup then refuses to run against an out-of-date schema.
AUTO_MIGRATE=True

# Access control. Individual sign-up is closed by default; create users administratively.
# Set REGISTRATION_ENABLED=True only for an explicitly approved public-registration deployment.
# New accounts join DEFAULT_ACCESS_GROUP.
REGISTRATION_ENABLED=False
DEFAULT_ACCESS_GROUP=all

# Rate limits and reverse proxies. Without REDIS_URL, limits are counted per process; REDIS_URL
# needs `pip install "limits[redis]"`. TRUSTED_PROXIES: comma-separated IPs or CIDR ranges of reverse
# proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted (empty: trust none).
RATE_LIMIT_ENABLED=True
REDIS_URL=
TRUSTED_PROXIES=

# Developer / Admin Secret Key for Ingestion
# Optional (enables the X-Admin-Key header for scripted ingestion). Leave empty to disable.
# Same rules as JWT_SECRET: at least 32 random characters, never a published value.
ADMIN_API_KEY=

# REQUIRED for the admin portal (/admin/login): the super admin is created on first start, only if this
# email does not already exist. Existing accounts are never promoted or have their password changed.
# Password: 12+ characters and at most 72 UTF-8 bytes. Set both or neither.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ===== LLM providers =====
# Preferred LLM provider, tried first: 'groq' (default), 'gemini' or 'openrouter'.
# 'local' means no preferred provider (the allowlist order below is used).
LLM_PROVIDER=groq
# Approved provider failover order: Groq -> Gemini -> OpenRouter. Set empty to disable cloud text generation.
LLM_ALLOWED_PROVIDERS=groq,gemini,openrouter
LLM_ALLOW_FREE_TIER=True
LLM_MODEL=openai/gpt-oss-120b
# Keys: https://console.groq.com/keys, https://aistudio.google.com/apikey, https://openrouter.ai/keys
# Set at least one. Providers without a key are skipped.
GROQ_API_KEY=
# Tokens per minute per Groq model (prompt + reserved output). Free tier is 8000; raise it on a paid tier.
# A value above the real limit makes Groq reject requests (413); a lower limit stated in a 413 is learned.
GROQ_TOKENS_PER_MINUTE=8000
# Small models used only after every other model failed (still before the web-search fallback).
# Empty puts every configured model in the normal Groq -> Gemini -> OpenRouter pass.
LLM_LAST_RESORT_MODELS=allam-2-7b,liquid/lfm-2.5-2.6b:free
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ===== RAG & Embeddings =====
# Vectors record the model name they were made with. Changing EMBEDDING_MODEL after ingestion makes
# existing vectors incompatible until the knowledge base is re-ingested. Keep the same value on every
# machine that shares a database or restores its backups.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
TOP_K=10
RERANK_TOP_K=4
# Build the in-memory retrieval index in the background at startup and after document changes,
# instead of inside the next user request (about 10 s for 31k chunks).
RETRIEVAL_CACHE_WARMUP=True
SIMILARITY_THRESHOLD=0.60
GROUNDING_THRESHOLD=0.65
DOCUMENT_MATCH_THRESHOLD=0.80
AUTO_MULTI_SOURCE_FALLBACK=True
ANSWER_TEMPERATURE=0.10
# Documents default to source tier "self_authored", which retrieval skips unless this is True.
# On a FRESH database every ingested document starts as self_authored, so Scholar finds nothing until
# you set tiers (PATCH /api/documents/{id}/tier) or, for local development only, set this to True.
INCLUDE_SELF_AUTHORED_DOCS=False

# ===== Tavily web search (https://app.tavily.com) =====
WEB_FALLBACK_ENABLED=True
# Tavily API key used for SAP web and image search. Empty: no web evidence.
WEB_SEARCH_API_KEY=
TAVILY_MAX_RESULTS=5
# Maximum relevant visuals included for explicit visual requests.
TAVILY_MAX_IMAGES=4

# GitHub Repository Retrieval & Multi-Source Comparison (Default FALSE)
REPO_SOURCE_ENABLED=false
MULTI_SOURCE_COMPARE_ENABLED=false

# Extended Official SAP Web & Community Sources (Default FALSE)
SAP_WEB_SOURCES_ENABLED=false

# ===== Organisation Portal (docs/ORGANISATION_PORTAL.md) =====
# Hours an organisation activation code stays valid (single use; issuing a new code revokes unused ones).
ORG_ACTIVATION_CODE_TTL_HOURS=72
# Per-IP budgets for the public activation (verify/complete) and organisation-request endpoints.
ORG_ACTIVATION_RATE_LIMIT_PER_MINUTE=10
ORG_REQUEST_RATE_LIMIT_PER_HOUR=5
# Members an organisation administrator may create per hour.
ORG_MEMBER_CREATE_RATE_LIMIT_PER_HOUR=30
