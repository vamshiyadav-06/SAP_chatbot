# Docker Compose settings for the PostgreSQL + pgvector container.
# Copy to .env (repository root) and set real passwords.

# Host port mapped to the container's 5432. Must match the port in backend/.env DATABASE_URL.
POSTGRES_HOST_PORT=5434

# Superuser; only applied when the data volume is first initialised.
POSTGRES_USER=sap_assistant
POSTGRES_PASSWORD=change-me-superuser-password
POSTGRES_DB=sap_assistant

# Password for the application role "sap_brim_ai" (created on first initialisation).
# Must match the password in backend/.env DATABASE_URL.
SAP_BRIM_DB_PASSWORD=change-me-app-password

# SearXNG Metasearch service (internal port 8080)
SEARXNG_HOST_PORT=8089
SEARXNG_SECRET=change-me-searxng-secret-token-32b

# Siftdog Search & Extraction API service (internal port 8000)
SIFTDOG_HOST_PORT=8088
SIFTDOG_API_KEY=
SIFTDOG_FETCH_TIMEOUT=15
SIFTDOG_FETCH_CONCURRENCY=10
SIFTDOG_FETCH_MAX_BYTES=2097152
SIFTDOG_ALLOW_PRIVATE_NETWORKS=false
SIFTDOG_CRAWL_MAX_LIMIT=50
