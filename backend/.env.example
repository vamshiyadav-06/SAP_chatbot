# SAP Knowledge Assistant Configuration

# Database: PostgreSQL + pgvector in Docker (the only supported database; no fallback).
# Start it with `docker compose up -d postgres` from the repository root.
# Host-run backend: 127.0.0.1:<POSTGRES_HOST_PORT>. Backend inside the compose network: postgres:5432.
DATABASE_URL=postgresql://sap_brim_ai:change-me-app-password@127.0.0.1:5434/sap_brim_ai
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Security
# Required: a random value of at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse a value from this file: published values are rejected at startup.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Developer / Admin Secret Key for Ingestion
# Optional (enables the X-Admin-Key header for scripted ingestion). Leave empty to disable.
# Same rules as JWT_SECRET: at least 32 random characters, never a published value.
ADMIN_API_KEY=

# Super admin created on first start (an existing account's password is never overwritten).
# Password: at least 12 characters. Change it after first login.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# LLM Provider Options: 'groq' (default ultra-fast), 'gemini', 'openrouter', 'openai', or 'local'
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Tokens per minute per Groq model (prompt + reserved output). Free tier is 8000; raise it on a paid tier.
GROQ_TOKENS_PER_MINUTE=8000
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
TOP_K=10
RERANK_TOP_K=4
SIMILARITY_THRESHOLD=0.60
GROUNDING_THRESHOLD=0.65
DOCUMENT_MATCH_THRESHOLD=0.80
AUTO_MULTI_SOURCE_FALLBACK=True
ANSWER_TEMPERATURE=0.10

# Web Fallback & Self-Hosted Search Providers (Siftdog + SearXNG)
WEB_FALLBACK_ENABLED=True
# Provider choice: "siftdog" (default, self-hosted via SearXNG), "searxng" (direct metasearch), or "tavily" (hosted API)
SEARCH_PROVIDER=siftdog
SIFTDOG_URL=http://127.0.0.1:8088
SIFTDOG_API_KEY=
SEARXNG_URL=http://127.0.0.1:8089
SEARCH_TIMEOUT_SECONDS=15.0
SEARCH_MAX_RETRIES=2
SEARCH_FALLBACK_TO_SEARXNG=True
SEARCH_EXTRACTION_ENABLED=True
SEARCH_DEFAULT_TOPIC=general

# Legacy Tavily API key (used if SEARCH_PROVIDER=tavily or as cloud fallback)
WEB_SEARCH_API_KEY=
# Maximum relevant visuals included for explicit visual requests.
TAVILY_MAX_IMAGES=4

# GitHub Repository Retrieval & Multi-Source Comparison (Default FALSE)
REPO_SOURCE_ENABLED=false
MULTI_SOURCE_COMPARE_ENABLED=false

# Extended Official SAP Web & Community Sources (Default FALSE)
SAP_WEB_SOURCES_ENABLED=false
