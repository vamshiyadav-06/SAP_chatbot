# =====================================================================================================
# SAP BRIM AI (Clyptus.AI) - PRODUCTION settings template for docker-compose.prod.yml
# =====================================================================================================
# On the server, in the repository root:
#     cp .env.production.example .env
#     chmod 600 .env
# then replace EVERY value marked CHANGE (search for "change-me" and "example.com") and set the empty
# REQUIRED values. Step-by-step guide: DEPLOYMENT.md. Never commit `.env`.
#
# Generate each secret/password separately with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# (URL-safe output: it is also written inside DATABASE_URL, so avoid @ : / ? # % in passwords.)
#
# The backend refuses to start in production with an empty or short JWT_SECRET, a "change-me" database
# or admin password, or localhost/wildcard ALLOWED_ORIGINS.
# =====================================================================================================

# Makes plain `docker compose ...` in this folder use the production stack (no `-f` needed).
COMPOSE_FILE=docker-compose.prod.yml
APP_ENV_FILE=.env

# ===== Public address =====
# CHANGE: the host name users open, without https:// (DNS A/AAAA record must point at this server).
# Caddy (the web container) gets the HTTPS certificate for it automatically from Let's Encrypt.
APP_DOMAIN=assistant.example.com
# CHANGE: the same host name with https://. The only origin allowed to call the API.
ALLOWED_ORIGINS=https://assistant.example.com
ENVIRONMENT=production

# Numeric user id that owns ./knowledge_base on the server (`id -u`); the backend container runs as it
# so admin uploads can be saved there. Not 0 (root). Rebuild after changing it.
APP_UID=1000

# Host ports of the web container. Keep 80 and 443 for automatic HTTPS.
HTTP_PORT=80
HTTPS_PORT=443
# 0.0.0.0 = reachable from the internet; 127.0.0.1 = only from this server (private testing).
WEB_BIND=0.0.0.0

# Access gate in front of the app: open (production) or basic_auth (see .env.staging.example).
ACCESS_MODE=open
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_HASH=

# Image tag built and started; scripts/staging/deploy.sh sets it to the git commit so rollback can
# start the previous one.
IMAGE_TAG=latest

# Container resource limits (CPUs / memory). The backend needs about 1.5 GB for PyTorch and the
# embedding model; keep the total below the server's RAM.
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1g
BACKEND_CPUS=2.0
BACKEND_MEMORY=3g
WEB_CPUS=0.5
WEB_MEMORY=256m

# ===== PostgreSQL + pgvector container (not published outside Docker) =====
# Superuser; only applied when the data volume is first initialised.
POSTGRES_USER=sap_assistant
# CHANGE (REQUIRED)
POSTGRES_PASSWORD=change-me-superuser-password
POSTGRES_DB=sap_assistant
# CHANGE (REQUIRED): password of the application role "sap_brim_ai", created on first initialisation.
SAP_BRIM_DB_PASSWORD=change-me-app-password
# CHANGE: put the SAME app password here. Host "postgres" is the database container on the Docker network.
DATABASE_URL=postgresql://sap_brim_ai:change-me-app-password@postgres:5432/sap_brim_ai
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===== Security =====
# REQUIRED: at least 32 random characters (see the command at the top).
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Sessions renew silently with a rotating refresh token (httpOnly cookie) for up to this many days.
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional X-Admin-Key header for scripted ingestion. Empty disables it; otherwise 32+ random characters.
ADMIN_API_KEY=

# REQUIRED: the super admin (/admin/login), created on the first start if this email does not exist yet.
# Password: 12-72 characters. Changing these later does NOT change an existing admin's password
# (use: docker compose exec backend python backend/scripts/set_admin_password.py <email>).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Individual sign-up is closed; users are provisioned by an administrator.
REGISTRATION_ENABLED=False
DEFAULT_ACCESS_GROUP=all

# Rate limits and login lockout. The stack runs one backend worker, so per-process counting is exact.
# Set REDIS_URL only if you add workers or replicas (needs `limits[redis]` in the image).
RATE_LIMIT_ENABLED=True
REDIS_URL=
# TRUSTED_PROXIES and AUTO_MIGRATE are set by docker-compose.prod.yml (Caddy on the private Docker network;
# migrations run when the backend container starts).

# ===== LLM providers (set at least one key) =====
# Keys: https://console.groq.com/keys, https://aistudio.google.com/apikey, https://openrouter.ai/keys
LLM_PROVIDER=groq
LLM_ALLOWED_PROVIDERS=groq,gemini,openrouter
LLM_ALLOW_FREE_TIER=True
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# 8000 on Groq's free tier; raise it on a paid tier.
GROQ_TOKENS_PER_MINUTE=8000
LLM_LAST_RESORT_MODELS=allam-2-7b,liquid/lfm-2.5-2.6b:free
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Whole-request time budget for one answer (all providers, repair and web fallback), in seconds.
LLM_REQUEST_DEADLINE_SECONDS=120
# Longest question accepted (characters); longer ones are rejected with a clear message.
MAX_MESSAGE_CHARS=12000

# ===== RAG & Embeddings =====
# Baked into the backend image at build time (rebuild after a change). Must match the model the
# database's vectors were made with: keep the value used on the machine whose backup you restore.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
TOP_K=10
RERANK_TOP_K=4
RETRIEVAL_CACHE_WARMUP=True
SIMILARITY_THRESHOLD=0.60
GROUNDING_THRESHOLD=0.65
DOCUMENT_MATCH_THRESHOLD=0.80
AUTO_MULTI_SOURCE_FALLBACK=True
ANSWER_TEMPERATURE=0.10
# Keep False in production and set document tiers instead (DEPLOYMENT.md, "Load the knowledge base").
INCLUDE_SELF_AUTHORED_DOCS=False

# ===== Tavily web search (https://app.tavily.com) =====
WEB_FALLBACK_ENABLED=True
WEB_SEARCH_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_MAX_IMAGES=4
REPO_SOURCE_ENABLED=false
MULTI_SOURCE_COMPARE_ENABLED=false
SAP_WEB_SOURCES_ENABLED=false

# ===== Organisation Portal =====
ORG_ACTIVATION_CODE_TTL_HOURS=72
ORG_ACTIVATION_RATE_LIMIT_PER_MINUTE=10
ORG_REQUEST_RATE_LIMIT_PER_HOUR=5
ORG_MEMBER_CREATE_RATE_LIMIT_PER_HOUR=30

# ===== Frontend build (optional) =====
# Empty (recommended): the browser calls https://<APP_DOMAIN>/api, which Caddy forwards to the backend.
# Set only when the API is served from another origin, e.g. https://api.example.com/api. Rebuild after a change.
VITE_API_BASE_URL=
